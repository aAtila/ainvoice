{
  "extends": "next/core-web-vitals",
  "ignorePatterns": [
    "src/generated/**/*",
    "node_modules/**/*",
    ".next/**/*",
    "out/**/*",
    "build/**/*"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": ["error", { 
      "argsIgnorePattern": "^_",
      "varsIgnorePattern": "^_"
    }],
    "@typescript-eslint/no-explicit-any": ["warn"]
  }
}